# ──────────────────────────────────────────────────────────────────────────────
# BlokeTuber API — Environment Variables
# Copy this file to apps/api/.env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# ── DATABASE (Supabase) ───────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string → URI
# Use the "Session" pooler (port 5432) for this long-running Node.js server
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Pricing: $0.0015 per minute of audio (~$0.02 for a 15-min video narration)
# Model options: openai/whisper-large-v3 (best) or openai/whisper-1 (cheaper)

# Single batch call that plans smart cuts + media decisions for the full script.
# Default: google/gemini-2.5-flash (~$0.10-0.40/video — best cost/quality ratio)
# Premium: anthropic/claude-sonnet-4-5 (~$4-6/video — highest quality, highest cost)
# Default: google/gemini-2.5-flash-lite (clip matching) / google/gemini-2.5-flash (vision scoring)

# ── STOCK FOOTAGE ─────────────────────────────────────────────────────────────
# Pexels (free): https://www.pexels.com/api/  → Create account → "Your API Key"
PEXELS_API_KEY=

# Pixabay (free): https://pixabay.com/api/docs/ → Register → API Key shown on page
PIXABAY_API_KEY=

# Coverr and Mixkit are searched automatically — no key needed.

# ── APP CONFIG ────────────────────────────────────────────────────────────────
PORT=3001
WEB_URL=http://localhost:3000
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output
NODE_ENV=development

# NO cloud AI APIs. Transcription = local faster-whisper; planning/screening = Antigravity agent.
DISABLE_VISION_CHECK=true
DISABLE_LOCAL_WHISPER=false
